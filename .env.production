# ===================================
# .env.production
# Production environment configuration
# ===================================

# Build configuration
BUILD_TARGET=production
NODE_ENV=production

# Disable source mounting in production
SOURCE_MOUNT_MODE=ro
BACKEND_SOURCE_MOUNT=./backend/storage

# Backend configuration
BACKEND_COMMAND=node dist/main
DATABASE_USERNAME=your_prod_db_user
DATABASE_PASSWORD=your_secure_prod_password
JWT_SECRET=your-very-secure-production-jwt-secret
JWT_EXPIRES_IN=24h

# Frontend configuration
FRONTEND_COMMAND=node server.js
NEXT_PUBLIC_API_URL=https://api.yourdomain.com
FRONTEND_URL=https://yourdomain.com

# Disable file watching in production
WATCHPACK_POLLING=false
CHOKIDAR_USEPOLLING=false
